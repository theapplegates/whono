---
import AdminHelpTip from './AdminHelpTip.astro';
import AdminIcon from './AdminIcon.astro';
import AdminSettingSwitch from './AdminSettingSwitch.astro';
import AdminSiteSocialSection from './AdminSiteSocialSection.astro';
import { ADMIN_OVERVIEW_HIDDEN_MESSAGE_MAX_LENGTH } from '../../lib/admin-console/theme-shared';

interface Props {
  footerStartYearMin: number;
  footerStartYearMax: number;
  socialCustomLimit: number;
}

const { footerStartYearMin, footerStartYearMax, socialCustomLimit } = Astro.props;
---

<fieldset class="admin-section">
  <legend class="admin-sr-only"><h2>Site settings</h2></legend>

  <div class="admin-subsection">
    <div class="admin-fields admin-fields--2">
      <label class="admin-field">
        <span class="admin-field__label">Site title</span>
        <input class="admin-field__control" id="site-title" type="text" autocomplete="off" />
      </label>
      <label class="admin-field">
        <span class="admin-field__label">Site language</span>
        <input class="admin-field__control" id="site-default-locale" type="text" autocomplete="off" />
      </label>
    </div>
    <div class="admin-field">
      <div class="admin-field__head">
        <AdminHelpTip id="site-description-tip" text="Used in search results and share summaries.">
          <label class="admin-field__label" for="site-description">Default SEO description</label>
        </AdminHelpTip>
      </div>
      <textarea
        class="admin-field__control admin-field__control--compact-textarea"
        id="site-description"
        rows="2"
        aria-describedby="site-description-tip"
      ></textarea>
    </div>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="site-footer-title">
    <div class="admin-subsection__head">
      <h3 id="site-footer-title" class="admin-subsection__title">Footer</h3>
    </div>
    <div class="admin-fields admin-fields--lead">
      <label class="admin-field">
        <span class="admin-field__label">Start year</span>
        <input
          class="admin-field__control"
          id="site-footer-start-year"
          type="number"
          min={footerStartYearMin}
          max={footerStartYearMax}
          step="1"
          inputmode="numeric"
          placeholder={String(footerStartYearMax)}
          aria-describedby="site-footer-preview"
        />
      </label>
      <label class="admin-field">
        <span class="admin-field__label">Copyright text</span>
        <input class="admin-field__control" id="site-footer-copyright" type="text" autocomplete="off" aria-describedby="site-footer-preview" />
      </label>
    </div>
    <AdminSettingSwitch id="site-footer-show-current-year" checked>
      Append the current year to the start year
      <Fragment slot="description">When enabled, displays as “start year–{footerStartYearMax}” and updates automatically each year.</Fragment>
    </AdminSettingSwitch>
    <p id="site-footer-preview" class="admin-help admin-preview">
      <span class="admin-preview__label">Preview</span>
      <span id="site-footer-preview-value" class="admin-preview__value">© {footerStartYearMax} Whono · Theme Demo · by cxro</span>
    </p>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="site-overview-title" data-reveal-scope>
    <div class="admin-subsection__head">
      <h3 id="site-overview-title" class="admin-subsection__title">Admin overview page</h3>
    </div>
    <AdminSettingSwitch id="site-admin-overview-public-visible" checked inputAttrs={{ 'data-reveal-source': true }}>
      Make the <code>/admin/</code> overview public
      <Fragment slot="description">Visitors can view the site overview, and search engines will not index it; when disabled, the page only shows a message. Applies after build.</Fragment>
    </AdminSettingSwitch>
    <label class="admin-field" data-reveal-when-off>
      <span class="admin-field__label">Text shown when disabled</span>
      <input
        class="admin-field__control"
        id="site-admin-overview-hidden-message"
        type="text"
        maxlength={ADMIN_OVERVIEW_HIDDEN_MESSAGE_MAX_LENGTH}
        autocomplete="off"
        disabled
      />
    </label>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="site-favicon-title">
    <div class="admin-subsection__head">
      <h3 id="site-favicon-title" class="admin-subsection__title">Site icons</h3>
    </div>
    <p class="admin-subsection__desc">Browser tab and mobile home screen icons. Applies after build.</p>
    <input id="site-favicon-svg" type="hidden" />
    <input id="site-favicon-png" type="hidden" />
    <input id="site-favicon-apple-touch-icon" type="hidden" />
    <ul class="admin-asset-list">
      <li class="admin-asset" data-favicon-slot="png">
        <span class="admin-asset__preview" data-favicon-preview="png">
          <img alt="" loading="lazy" decoding="async" data-favicon-preview-img="png" />
        </span>
        <span class="admin-asset__text">
          <span class="admin-asset__name">Favicon</span>
          <span class="admin-asset__meta">PNG for browser tabs and bookmarks</span>
        </span>
        <span class="admin-asset__actions">
          <button class="admin-btn admin-btn--ghost admin-btn--mini" type="button" data-favicon-upload="png" aria-label="Upload favicon">
            <AdminIcon name="upload" size={13} strokeWidth={2.2} />
            <span>Upload</span>
          </button>
          <button class="admin-btn admin-btn--ghost admin-btn--mini" type="button" data-favicon-clear="png" aria-label="Restore default favicon">
            <AdminIcon name="refresh" size={13} strokeWidth={2.2} />
            <span>Restore default</span>
          </button>
        </span>
      </li>
      <li class="admin-asset" data-favicon-slot="appleTouchIcon">
        <span class="admin-asset__preview" data-favicon-preview="appleTouchIcon">
          <img alt="" loading="lazy" decoding="async" data-favicon-preview-img="appleTouchIcon" />
        </span>
        <span class="admin-asset__text">
          <span class="admin-asset__name">Touch icon</span>
          <span class="admin-asset__meta">PNG used when added to a mobile home screen</span>
        </span>
        <span class="admin-asset__actions">
          <button class="admin-btn admin-btn--ghost admin-btn--mini" type="button" data-favicon-upload="appleTouchIcon" aria-label="Upload touch icon">
            <AdminIcon name="upload" size={13} strokeWidth={2.2} />
            <span>Upload</span>
          </button>
          <button class="admin-btn admin-btn--ghost admin-btn--mini" type="button" data-favicon-clear="appleTouchIcon" aria-label="Restore default touch icon">
            <AdminIcon name="refresh" size={13} strokeWidth={2.2} />
            <span>Restore default</span>
          </button>
        </span>
      </li>
    </ul>
    <input type="file" accept="image/png" hidden data-favicon-file="png" />
    <input type="file" accept="image/png" hidden data-favicon-file="appleTouchIcon" />
    <p class="admin-help">
      Recommended: a square 256×256 PNG (16–512 px per side, up to 256 KB). To use an SVG icon, replace <code>public/favicon.svg</code> directly.
    </p>
  </div>

  <AdminSiteSocialSection socialCustomLimit={socialCustomLimit} />
</fieldset>
