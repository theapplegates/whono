---
import type { SidebarNavId } from '../../lib/theme-settings';
import AdminDiagnosticPanel from './AdminDiagnosticPanel.astro';
import AdminHomeSection from './AdminHomeSection.astro';
import AdminIcon from './AdminIcon.astro';
import AdminPageSection from './AdminPageSection.astro';
import AdminArticleSection from './AdminArticleSection.astro';
import AdminSidebarSection from './AdminSidebarSection.astro';
import AdminSiteSection from './AdminSiteSection.astro';
import AdminTypographySection from './AdminTypographySection.astro';

interface Props {
  bootstrapText: string;
  footerStartYearMin: number;
  footerStartYearMax: number;
  homeIntroMaxLength: number;
  memoSubtitlePlaceholder: string;
  memoTitlePlaceholder: string;
  navIdOrder: readonly SidebarNavId[];
  pageSubtitleMaxLength: number;
  pageTitleMaxLength: number;
  settingsEndpoint: string;
  socialCustomLimit: number;
}

const {
  bootstrapText,
  footerStartYearMin,
  footerStartYearMax,
  homeIntroMaxLength,
  memoSubtitlePlaceholder,
  memoTitlePlaceholder,
  navIdOrder,
  pageSubtitleMaxLength,
  pageTitleMaxLength,
  settingsEndpoint,
  socialCustomLimit
} = Astro.props;

// 分组标签：一次只显示一个分组，其余分组用 hidden 隐藏（不卸载，脚本仍能取到全部控件），统一保存。
// id 同时用作地址栏 hash（#sidebar 等），刷新后停留在当前分组。
const sectionTabs = [
  { id: 'site', label: 'Site', icon: 'admin-site' },
  { id: 'sidebar', label: 'Sidebar', icon: 'admin-sidebar' },
  { id: 'home', label: 'Home', icon: 'admin-homepage' },
  { id: 'page', label: 'Pages', icon: 'admin-page' },
  { id: 'article', label: 'Article', icon: 'admin-article' },
  { id: 'typography', label: 'Typography', icon: 'admin-typography' }
] as const;
type SectionTabId = (typeof sectionTabs)[number]['id'];
const defaultTabId: SectionTabId = sectionTabs[0].id;
const panelAttrs = (id: SectionTabId) => ({
  id: `admin-panel-${id}`,
  role: 'tabpanel' as const,
  'aria-labelledby': `admin-tab-${id}`,
  hidden: id !== defaultTabId
});
---

<section class="admin-theme-console" data-admin-root data-settings-endpoint={settingsEndpoint}>
  <div class="admin-tabs-bar">
    <div class="admin-tabs" role="tablist" aria-label="Theme settings sections">
      {
        sectionTabs.map((tab) => (
          <button
            id={`admin-tab-${tab.id}`}
            class="admin-tabs__tab"
            type="button"
            role="tab"
            aria-selected={tab.id === defaultTabId ? 'true' : 'false'}
            aria-controls={`admin-panel-${tab.id}`}
            tabindex={tab.id === defaultTabId ? 0 : -1}
            data-admin-tab={tab.id}
          >
            <AdminIcon name={tab.icon} class="admin-tabs__icon" size={16} />
            {tab.label}
            <span class="admin-tabs__dot" data-admin-tab-invalid hidden>
              <span class="admin-sr-only">(Has issues to resolve)</span>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <AdminDiagnosticPanel
    bannerId="admin-error-banner"
    titleId="admin-error-title"
    messageId="admin-error-message"
    listId="admin-error-list"
    title="Operation not completed"
    label="Configuration error"
    retryAction={{
      id: 'admin-error-retry',
      label: 'Check again'
    }}
    tabindex={-1}
  />

  <form id="admin-form" class="admin-form" novalidate>
    <div {...panelAttrs('site')}>
      <AdminSiteSection
        footerStartYearMin={footerStartYearMin}
        footerStartYearMax={footerStartYearMax}
        socialCustomLimit={socialCustomLimit}
      />
    </div>

    <div {...panelAttrs('sidebar')}>
      <AdminSidebarSection navIdOrder={navIdOrder} />
    </div>

    <div {...panelAttrs('home')}>
      <AdminHomeSection homeIntroMaxLength={homeIntroMaxLength} />
    </div>

    <div {...panelAttrs('page')}>
      <AdminPageSection
        pageTitleMaxLength={pageTitleMaxLength}
        pageSubtitleMaxLength={pageSubtitleMaxLength}
        memoTitlePlaceholder={memoTitlePlaceholder}
        memoSubtitlePlaceholder={memoSubtitlePlaceholder}
      />
    </div>

    <div {...panelAttrs('article')}>
      <AdminArticleSection />
    </div>

    <div {...panelAttrs('typography')}>
      <AdminTypographySection />
    </div>
  </form>

  <div id="admin-actions-sentinel" class="admin-actions__sentinel" aria-hidden="true"></div>
  <div id="admin-actions" class="admin-actions" data-dirty="false" data-sticky="false">
    <div class="admin-actions__meta">
      <p id="admin-dirty-banner" class="admin-banner admin-banner--dirty" hidden>
        * You have unsaved changes.
      </p>
    </div>
    <div class="admin-actions__controls">
      <p id="admin-status-inline" class="admin-status admin-status--inline" data-state="idle" aria-hidden="true">
        Loading…
      </p>
      <div class="admin-actions__buttons">
        <button id="admin-validate" class="admin-btn admin-btn--secondary admin-btn--compact" type="button">Validate settings</button>
        <button id="admin-reset" class="admin-btn admin-btn--ghost admin-btn--compact" type="button">Reset changes</button>
        <button id="admin-save" class="admin-btn admin-btn--primary admin-btn--compact" type="button">Save</button>
      </div>
    </div>
  </div>

  <div id="admin-bootstrap" hidden>{bootstrapText}</div>
</section>
