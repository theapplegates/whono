---
import AdminHelpTip from './AdminHelpTip.astro';
import AdminSettingSwitch from './AdminSettingSwitch.astro';
import UiIcon from '../UiIcon.astro';
import type { SidebarNavId } from '../../lib/theme-settings';
import {
  ADMIN_NAV_ORNAMENT_DEFAULT,
  ADMIN_NAV_ORNAMENT_MAX_LENGTH,
  ADMIN_SIDEBAR_DIVIDER_OPTIONS
} from '../../lib/admin-console/theme-shared';

interface Props {
  navIdOrder: readonly SidebarNavId[];
}

const { navIdOrder } = Astro.props;
---

<fieldset class="admin-section">
  <legend class="admin-sr-only"><h2>Sidebar settings</h2></legend>

  <div class="admin-subsection">
    <div class="admin-fields admin-fields--2">
      <label class="admin-field">
        <span class="admin-field__label">Sidebar site name</span>
        <input class="admin-field__control" id="shell-brand-title" type="text" autocomplete="off" />
      </label>
      <div class="admin-field">
        <span class="admin-field__label" id="ui-layout-sidebar-divider-label">Sidebar divider</span>
        <div class="admin-segmented" role="radiogroup" aria-labelledby="ui-layout-sidebar-divider-label">
          {
            ADMIN_SIDEBAR_DIVIDER_OPTIONS.map((option) => (
              <label class="admin-segmented__option" for={`ui-layout-sidebar-divider-${option.id}`}>
                <input
                  id={`ui-layout-sidebar-divider-${option.id}`}
                  name="ui-layout-sidebar-divider"
                  type="radio"
                  value={option.id}
                  checked={option.id === 'default'}
                />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </div>
      <label class="admin-field admin-field--full">
        <span class="admin-field__label">Sidebar quote text</span>
        <textarea class="admin-field__control" id="shell-quote" rows="4"></textarea>
      </label>
    </div>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="sidebar-icons-title" aria-describedby="sidebar-icons-tip">
    <div class="admin-subsection__head">
      <h3 id="sidebar-icons-title" class="admin-subsection__title">
        <AdminHelpTip id="sidebar-icons-tip" text="Choose the icons shown at the bottom of the sidebar.">Sidebar icons</AdminHelpTip>
      </h3>
    </div>
    <AdminSettingSwitch id="ui-reading-entry">
      <UiIcon name="book-open" class="admin-setting__icon" size={15} strokeWidth={2} />
      Reading mode
    </AdminSettingSwitch>
    <AdminSettingSwitch id="ui-sidebar-actions-show-rss-link">
      <UiIcon name="rss" class="admin-setting__icon" size={15} strokeWidth={2} />
      RSS feed
    </AdminSettingSwitch>
    <AdminSettingSwitch id="ui-sidebar-actions-show-theme-toggle">
      <UiIcon name="moon" class="admin-setting__icon" size={15} strokeWidth={2} />
      Theme toggle
    </AdminSettingSwitch>
    <AdminSettingSwitch id="ui-sidebar-actions-show-admin-entry" rowId="ui-sidebar-actions-show-admin-entry-row">
      <UiIcon name="monitor-dot" class="admin-setting__icon" size={15} strokeWidth={2} />
      Site overview <code>/admin/</code>
      <Fragment slot="description">First make the overview page public in Site settings.</Fragment>
    </AdminSettingSwitch>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="sidebar-nav-title">
    <div class="admin-subsection__head">
      <h3 id="sidebar-nav-title" class="admin-subsection__title">
        <AdminHelpTip
          id="admin-nav-ornament-hint"
          text={`Suffixes support short text or symbols; leave blank to hide, enter ${ADMIN_NAV_ORNAMENT_DEFAULT} to restore the default.`}
        >Sidebar navigation</AdminHelpTip>
      </h3>
    </div>
    <div class="admin-table admin-nav-table">
      <div class="admin-table__head admin-nav-header" aria-hidden="true">
        <span class="admin-nav-header__center">Order</span>
        <span>Page</span>
        <span class="admin-nav-header__center">Navigation label</span>
        <span class="admin-nav-header__center">Suffix</span>
        <span class="admin-nav-header__center">Show</span>
      </div>
      {
        navIdOrder.map((id, index) => (
          <div class="admin-row admin-row--interactive admin-row--table admin-table__row admin-nav-row" data-nav-id={id}>
            <label class="admin-nav-cell admin-nav-cell--order admin-field--compact">
              <span class="sr-only">{id} order</span>
              <input
                class="admin-field__control admin-field__control--quiet admin-nav-order"
                data-nav-field="order"
                name={`shell-nav-${id}-order`}
                type="number"
                min="1"
                step="1"
                inputmode="numeric"
                value={index + 1}
              />
            </label>
            <span class="admin-nav-cell admin-nav-cell--page">{id}</span>
            <label class="admin-nav-cell admin-nav-cell--label admin-field--compact">
              <span class="sr-only">{id} navigation label</span>
              <input
                class="admin-field__control admin-field__control--quiet admin-nav-label"
                data-nav-field="label"
                name={`shell-nav-${id}-label`}
                type="text"
                autocomplete="off"
              />
            </label>
            <label class="admin-nav-cell admin-nav-cell--ornament admin-field--compact">
              <span class="sr-only">{id} navigation suffix; leave blank to hide</span>
              <input
                class="admin-field__control admin-field__control--quiet admin-nav-ornament"
                data-nav-field="ornament"
                name={`shell-nav-${id}-ornament`}
                type="text"
                autocomplete="off"
                maxlength={ADMIN_NAV_ORNAMENT_MAX_LENGTH}
                placeholder="None"
                aria-describedby="admin-nav-ornament-hint"
              />
            </label>
            <span class="admin-nav-cell admin-nav-cell--visible">
              <span class="admin-switch">
                <input
                  class="admin-switch__input"
                  data-nav-field="visible"
                  name={`shell-nav-${id}-visible`}
                  type="checkbox"
                  role="switch"
                  aria-label={`Show ${id}`}
                />
                <span class="admin-switch__track" aria-hidden="true"></span>
              </span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</fieldset>
