---
import AdminHelpTip from './AdminHelpTip.astro';

interface Props {
  pageTitleMaxLength: number;
  pageSubtitleMaxLength: number;
  memoTitlePlaceholder?: string;
  memoSubtitlePlaceholder?: string;
}

const {
  pageTitleMaxLength,
  pageSubtitleMaxLength,
  memoTitlePlaceholder = '',
  memoSubtitlePlaceholder = ''
} = Astro.props;

// 占位文字即留空时页面上显示的默认标题；没有默认副标题的显示「无」。
const pageTitleRows = [
  { id: 'essay', path: '/essay/', titlePlaceholder: 'Essays', subtitlePlaceholder: 'Essays and miscellany' },
  { id: 'bits', path: '/bits/', titlePlaceholder: 'Bits', subtitlePlaceholder: 'Life is more than long reads' },
  { id: 'memo', path: '/memo/', titlePlaceholder: memoTitlePlaceholder || undefined, subtitlePlaceholder: memoSubtitlePlaceholder || 'None' },
  { id: 'archive', path: '/archive/', titlePlaceholder: 'Archive', subtitlePlaceholder: 'Archive index grouped by year' },
  { id: 'about', path: '/about/', titlePlaceholder: 'About', subtitlePlaceholder: 'None' }
] as const;
---

<fieldset class="admin-section">
  <legend class="admin-sr-only"><h2>Page settings</h2></legend>

  <div class="admin-subsection" role="group" aria-labelledby="page-titles-title" aria-describedby="page-titles-tip">
    <div class="admin-subsection__head">
      <h3 id="page-titles-title" class="admin-subsection__title">
        <AdminHelpTip
          id="page-titles-tip"
          text="Overrides each page title when set; leave blank to use the gray default (/memo/ reads src/content/memo/index.md)."
        >Page titles</AdminHelpTip>
      </h3>
    </div>
    <div class="admin-table">
      <div class="admin-table__head admin-page-header" aria-hidden="true">
        <span>Page</span>
        <span class="admin-page-header__center">Main title</span>
        <span class="admin-page-header__input">Subtitle</span>
      </div>
      {
        pageTitleRows.map((row) => (
          <div class="admin-row admin-row--interactive admin-row--table admin-table__row admin-page-row">
            <span class="admin-page-cell admin-page-cell--path">{row.path}</span>
            <span class="admin-page-cell admin-page-cell--title admin-field--compact">
              <input
                id={`page-${row.id}-title`}
                class="admin-field__control admin-field__control--quiet admin-page-title-input"
                type="text"
                maxlength={pageTitleMaxLength}
                autocomplete="off"
                placeholder={row.titlePlaceholder}
                aria-label={`${row.path} page main title`}
              />
            </span>
            <span class="admin-page-cell admin-page-cell--subtitle admin-field--compact">
              <input
                id={`page-${row.id}-subtitle`}
                class="admin-field__control admin-field__control--quiet"
                type="text"
                maxlength={pageSubtitleMaxLength}
                autocomplete="off"
                placeholder={row.subtitlePlaceholder}
                aria-label={`${row.path} page subtitle`}
              />
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="page-bits-author-title">
    <div class="admin-subsection__head">
      <h3 id="page-bits-author-title" class="admin-subsection__title">/bits/ default author</h3>
    </div>
    <div class="admin-media admin-media--compact">
      <div class="admin-media__fields">
        <label class="admin-field">
          <span class="admin-field__label">Author name</span>
          <input class="admin-field__control" id="page-bits-author-name" type="text" autocomplete="off" />
        </label>
        <div class="admin-field">
          <div class="admin-field__head">
            <AdminHelpTip id="page-bits-author-avatar-tip" text="Enter a relative image path, or click Choose to pick a local image.">
              <label class="admin-field__label" for="page-bits-author-avatar">Avatar</label>
            </AdminHelpTip>
          </div>
          <div class="admin-images-field-input">
            <input
              class="admin-field__control"
              id="page-bits-author-avatar"
              type="text"
              autocomplete="off"
              aria-describedby="page-bits-author-avatar-tip"
            />
            <button
              class="admin-btn admin-btn--ghost"
              type="button"
              data-admin-images-open="page.bits.defaultAuthor.avatar"
              aria-label="Choose default Bits avatar"
            >
              Choose
            </button>
          </div>
        </div>
      </div>
      <div class="admin-media__preview">
        <span class="admin-field__label">Preview</span>
        <div
          class="admin-images-field-preview admin-images-field-preview--avatar"
          data-admin-images-preview="page.bits.defaultAuthor.avatar"
          hidden
        >
          <img alt="" loading="lazy" decoding="async" data-admin-images-preview-img="page.bits.defaultAuthor.avatar" />
        </div>
      </div>
    </div>
  </div>
</fieldset>
