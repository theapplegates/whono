---
import AdminHelpTip from './AdminHelpTip.astro';
import AdminSettingSwitch from './AdminSettingSwitch.astro';
import {
  ADMIN_HERO_IMAGE_ALT_DEFAULT,
  ADMIN_HERO_IMAGE_ALT_MAX_LENGTH,
  ADMIN_HOME_INTRO_LINK_DEFAULT,
  ADMIN_HOME_INTRO_LINK_OPTIONS
} from '../../lib/admin-console/theme-shared';
import defaultHero from '../../assets/hero.png';

interface Props {
  homeIntroMaxLength: number;
}

const { homeIntroMaxLength } = Astro.props;
---

<fieldset class="admin-section">
  <legend class="admin-sr-only"><h2>Home settings</h2></legend>

  <div class="admin-subsection" role="group" aria-labelledby="home-hero-title" data-reveal-scope>
    <div class="admin-subsection__head">
      <h3 id="home-hero-title" class="admin-subsection__title">Hero image</h3>
    </div>
    <AdminSettingSwitch id="home-show-hero" checked inputAttrs={{ 'data-reveal-source': true }}>
      Show hero image
    </AdminSettingSwitch>
    <div class="admin-media" data-reveal-when-on>
      <div class="admin-media__fields">
        <div class="admin-field">
          <div class="admin-field__head">
            <AdminHelpTip
              id="home-hero-image-src-tip"
              text="Supports src/assets/**, public/**, or https:// image host links; leave blank to use the built-in default image."
            >
              <label class="admin-field__label" for="home-hero-image-src">Image URL</label>
            </AdminHelpTip>
          </div>
          <div class="admin-images-field-input">
            <input
              class="admin-field__control"
              id="home-hero-image-src"
              type="text"
              inputmode="url"
              spellcheck="false"
              placeholder="Currently using: src/assets/hero.png"
              aria-describedby="home-hero-image-src-tip"
            />
            <button
              class="admin-btn admin-btn--ghost"
              type="button"
              data-admin-images-open="home.heroImageSrc"
              aria-label="Choose local hero image"
            >
              Choose
            </button>
          </div>
          <p class="admin-help" data-admin-images-meta="home.heroImageSrc" hidden></p>
        </div>
        <div class="admin-field">
          <div class="admin-field__head">
            <AdminHelpTip id="home-hero-image-alt-tip" text="Alternative text for screen readers and when the image fails to load; not displayed on the page.">
              <label class="admin-field__label" for="home-hero-image-alt">Alt text</label>
            </AdminHelpTip>
          </div>
          <input
            class="admin-field__control"
            id="home-hero-image-alt"
            type="text"
            maxlength={ADMIN_HERO_IMAGE_ALT_MAX_LENGTH}
            placeholder={ADMIN_HERO_IMAGE_ALT_DEFAULT}
            aria-describedby="home-hero-image-alt-tip"
          />
        </div>
      </div>
      <div class="admin-media__preview">
        <span class="admin-field__label">Preview</span>
        <div
          class="admin-images-field-preview admin-images-field-preview--hero"
          data-admin-images-preview="home.heroImageSrc"
          data-admin-images-default-preview-src={defaultHero.src}
          hidden
        >
          <img alt="" loading="lazy" decoding="async" data-admin-images-preview-img="home.heroImageSrc" />
          <span class="admin-images-field-placeholder" data-admin-images-preview-placeholder="home.heroImageSrc" hidden>
            Home hero image is not enabled
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="home-intro-title" aria-describedby="home-intro-tip">
    <div class="admin-subsection__head">
      <h3 id="home-intro-title" class="admin-subsection__title">
        <AdminHelpTip
          id="home-intro-tip"
          text="Intro below the hero image: one lead sentence; supporting text is assembled as “supporting text + link + optional ‘or’ + link”."
        >Home intro</AdminHelpTip>
      </h3>
    </div>

    <div class="admin-subsection__block" data-reveal-scope>
      <AdminSettingSwitch id="home-show-intro-lead" checked inputAttrs={{ 'data-reveal-source': true }}>
        Show lead text
      </AdminSettingSwitch>
      <div class="admin-field" data-reveal-when-on>
        <textarea
          class="admin-field__control admin-field__control--compact-textarea"
          id="home-intro-lead"
          rows="2"
          maxlength={homeIntroMaxLength}
          aria-label="Home intro lead text"
        ></textarea>
      </div>
    </div>

    <div class="admin-subsection__block" data-reveal-scope>
      <AdminSettingSwitch id="home-show-intro-more" checked inputAttrs={{ 'data-reveal-source': true }}>
        Show supporting text
      </AdminSettingSwitch>
      <div class="admin-intro-more" data-reveal-when-on>
        <div class="admin-intro-more__sentence" role="group" aria-label="Home intro supporting sentence">
          <textarea
            id="home-intro-more"
            class="admin-field__control admin-intro-more__text"
            rows="1"
            maxlength={homeIntroMaxLength}
            aria-label="Home intro supporting text"
          ></textarea>
          <select
            id="home-intro-more-link-primary"
            class="admin-field__control admin-intro-more__select"
            aria-label="Home intro supporting primary link"
          >
            {ADMIN_HOME_INTRO_LINK_OPTIONS.map((option) => (
              <option value={option.id} selected={option.id === ADMIN_HOME_INTRO_LINK_DEFAULT[0]}>
                {option.label}
              </option>
            ))}
          </select>
          <span id="home-intro-more-link-secondary-group" class="admin-intro-more__secondary" aria-disabled="true">
            <span class="admin-intro-more__or" aria-hidden="true">or</span>
            <select
              id="home-intro-more-link-secondary"
              class="admin-field__control admin-intro-more__select"
              aria-label="Home intro supporting secondary link"
              disabled
            >
              {ADMIN_HOME_INTRO_LINK_OPTIONS.map((option) => (
                <option value={option.id} selected={option.id === ADMIN_HOME_INTRO_LINK_DEFAULT[1]}>
                  {option.label}
                </option>
              ))}
            </select>
          </span>
        </div>
        <AdminSettingSwitch
          id="home-intro-more-link-secondary-enabled"
          tip="When enabled, the sentence becomes “supporting text + link or link”."
          inputAttrs={{ 'aria-controls': 'home-intro-more-link-secondary' }}
        >
          Use the second link
        </AdminSettingSwitch>
        <p class="admin-help admin-preview">
          <span class="admin-preview__label">Preview</span>
          <span id="home-intro-more-preview" class="admin-preview__value">For more articles, visit Archive.</span>
        </p>
      </div>
    </div>
  </div>
</fieldset>
