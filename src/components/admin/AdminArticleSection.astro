---
import AdminHelpTip from './AdminHelpTip.astro';
import AdminSettingSwitch from './AdminSettingSwitch.astro';
import {
  ADMIN_ARTICLE_META_DATE_LABEL_MAX_LENGTH,
  ADMIN_ARTICLE_SHARE_PLATFORM_OPTIONS
} from '../../lib/admin-console/theme-shared';
---

<fieldset class="admin-section">
  <legend class="admin-sr-only"><h2>Article settings</h2></legend>

  <div class="admin-subsection" role="group" aria-labelledby="ui-article-meta-title" aria-describedby="ui-article-meta-tip">
    <div class="admin-subsection__head">
      <h3 id="ui-article-meta-title" class="admin-subsection__title">
        <AdminHelpTip id="ui-article-meta-tip" text="A single line below the article title. Word count and reading time appear only on detail pages and are hidden on mobile.">Article metadata</AdminHelpTip>
      </h3>
    </div>
    <div class="admin-subsection__block" data-reveal-scope>
      <AdminSettingSwitch id="ui-article-meta-show-date" inputAttrs={{ 'data-reveal-source': true }}>
        Show publish date
        <label slot="aside" class="admin-setting__aside admin-field--compact" data-reveal-when-on>
          <span>Prefix</span>
          <input
            id="ui-article-meta-date-label"
            class="admin-field__control"
            type="text"
            maxlength={ADMIN_ARTICLE_META_DATE_LABEL_MAX_LENGTH}
            autocomplete="off"
            placeholder="Published:"
            aria-label="Publish date prefix"
          />
        </label>
      </AdminSettingSwitch>
    </div>
    <AdminSettingSwitch id="ui-article-meta-show-header-tags">
      Show tags below the article title
      <Fragment slot="description">Up to 3.</Fragment>
    </AdminSettingSwitch>
    <AdminSettingSwitch id="ui-article-meta-show-tags">
      Show tags in lists
      <Fragment slot="description">Shown on the home page and article lists.</Fragment>
    </AdminSettingSwitch>
    <AdminSettingSwitch id="ui-article-meta-show-word-count">Show word count</AdminSettingSwitch>
    <AdminSettingSwitch id="ui-article-meta-show-reading-time">Show reading time</AdminSettingSwitch>
    <p class="admin-help admin-preview">
      <span class="admin-preview__label">Preview</span>
      <span id="article-meta-preview-value" class="admin-preview__value">Published: 2026-03-18 · 2,416 words · ~6 min read</span>
    </p>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="ui-article-toc-title">
    <div class="admin-subsection__head">
      <h3 id="ui-article-toc-title" class="admin-subsection__title">Table of contents</h3>
    </div>
    <AdminSettingSwitch id="ui-article-toc-show-entry">
      Show table of contents on the right
      <Fragment slot="description">Only on /archive/ article detail pages, at viewport widths of 1440px and above.</Fragment>
    </AdminSettingSwitch>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="ui-article-footer-title">
    <div class="admin-subsection__head">
      <h3 id="ui-article-footer-title" class="admin-subsection__title">Article footer</h3>
    </div>
    <AdminSettingSwitch id="ui-article-footer-show-tags">
      Show tags
      <Fragment slot="description">Show all tags; click to open the tag page.</Fragment>
    </AdminSettingSwitch>
    <AdminSettingSwitch id="ui-article-footer-show-prev-next">Show previous / next article</AdminSettingSwitch>
    <div
      class="admin-setting-choices"
      role="group"
      aria-labelledby="ui-article-footer-share-title"
      aria-describedby="ui-article-footer-share-desc"
    >
      <div class="admin-setting__text">
        <span id="ui-article-footer-share-title" class="admin-setting__title">Share buttons</span>
        <p id="ui-article-footer-share-desc" class="admin-setting__desc">
          If all are unchecked, nothing is shown. Without SITE_URL, only the share card and copy link work.
        </p>
      </div>
      <div class="admin-setting-choices__list">
        {ADMIN_ARTICLE_SHARE_PLATFORM_OPTIONS.map(({ id, label }) => (
          <label class="admin-toggle-row">
            <input type="checkbox" value={id} data-article-share-platform />
            {label}
          </label>
        ))}
      </div>
    </div>
  </div>

  <div class="admin-subsection" role="group" aria-labelledby="ui-code-title">
    <div class="admin-subsection__head">
      <h3 id="ui-code-title" class="admin-subsection__title">Code blocks</h3>
    </div>
    <AdminSettingSwitch id="ui-code-line-numbers">Show line numbers</AdminSettingSwitch>
  </div>
</fieldset>
